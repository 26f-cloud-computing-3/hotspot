APP_NAME=backend
CORS_ORIGINS=["http://localhost:5173"]

# kakao | naver | google
MAP_PROVIDER=kakao

# Kakao Developers (https://developers.kakao.com) - free, no card required
KAKAO_MAP_REST_API_KEY=
KAKAO_MAP_JS_KEY=

# Naver Cloud Platform Maps
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# Google Cloud Maps Platform
GOOGLE_MAPS_API_KEY=

# Supabase Auth (https://supabase.com) - project URL, used to verify access tokens
SUPABASE_URL=

# Postgres connection string (Supabase > Connect > Connection string). Contains the DB password.
DATABASE_URL=
